{
  "name": "github-tag-action",
  "version": "4.0.0",
  "private": true,
  "description": "A GitHub Action to automatically bump and tag master, on merge, with the latest SemVer formatted version.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && pnpm run package",
    "test": "jest --testTimeout 10000",
    "check:lint": "prettier --check .",
    "check:fix": "prettier --write .",
    "check:types": "tsc --noEmit",
    "check": "pnpm run check:lint && pnpm run check:types",
    "package": "ncc build lib/main.js -o dist --no-cache --source-map --license licenses.txt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathieudutour/github-tag-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "Mathieu Dutour",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^4.0.0",
    "@semantic-release/commit-analyzer": "^8.0.1",
    "@semantic-release/release-notes-generator": "^9.0.3",
    "conventional-changelog-conventionalcommits": "^4.6.3",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@octokit/rest": "^18.12.0",
    "@types/jest": "^27.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^16.18.126",
    "@types/semver": "^7.8.0",
    "@vercel/ncc": "^0.45.0",
    "jest": "^27.5.1",
    "jest-circus": "^27.5.1",
    "js-yaml": "^4.3.2",
    "prettier": "2.4.1",
    "ts-jest": "^27.1.5",
    "typescript": "^4.9.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.23.0"
}
